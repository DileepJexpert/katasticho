# Katasticho ERP - Environment Variables
# Copy this file to .env and fill in the values.

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=katasticho
DB_USER=katasticho
DB_PASSWORD=          # REQUIRED - generate a strong password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=       # Optional - leave empty for local dev

# JWT
JWT_SECRET=           # REQUIRED - min 256 bits, e.g. openssl rand -base64 64
JWT_ACCESS_EXPIRY=15  # minutes
JWT_REFRESH_EXPIRY=7  # days

# AI
ANTHROPIC_API_KEY=    # Optional - enables AI chat features

# Email
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=        # API key from Resend / SES
MAIL_FROM=noreply@katasticho.com
MAIL_FROM_NAME=Katasticho

# WhatsApp Business
WHATSAPP_BUSINESS_API_KEY=

# Server
PORT=8080
CORS_ALLOWED_ORIGINS=https://app.katasticho.com,https://katasticho.com

# Production operations
SENTRY_DSN=           # Optional - backend Sentry error tracking DSN
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
RATE_LIMIT_REQUESTS_PER_MINUTE=1000
RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=20
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=10

# Flutter Web (Vercel build-time)
API_BASE_URL=https://api.katasticho.com
FLUTTER_SENTRY_DSN=   # Optional - Flutter Sentry error tracking DSN
