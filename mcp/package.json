{
  "name": "katasticho-mcp",
  "version": "0.1.0",
  "description": "MCP server for Katasticho — run the books from Claude Desktop / any agent. Wraps the Katasticho REST API; AI drafts, a human approves.",
  "type": "module",
  "bin": {
    "katasticho-mcp": "build/index.js"
  },
  "files": [
    "build"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/index.js', 0o755)\"",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
